---
// Ghost gallery — static shell. Only served after functions/ghost.js verifies cf_ghost
// (next() fall-through). Lists ghost projects from /api/catalog (included when cookie present).
import Base from '../layouts/Base.astro';
---

<Base title="👻 Ghost — Artifacts" description="Hidden projects.">
  <meta slot="head" name="robots" content="noindex" />
  <header class="gallery-head">
    <h1>👻 Ghost projects</h1>
    <p class="lede">Hidden from the public gallery.</p>
    <p class="count" id="ghost-count">Loading…</p>
  </header>

  <ul class="cards" id="ghost-cards"></ul>
  <p class="no-results" id="ghost-empty" hidden>No ghost projects configured.</p>

  <p class="count" style="margin-top: 2.5rem"><a href="/ghost?logout=1">Sign out of ghost mode</a></p>
</Base>

<script is:inline>
  (async function () {
    const cards = document.getElementById('ghost-cards');
    const countEl = document.getElementById('ghost-count');
    const emptyEl = document.getElementById('ghost-empty');
    try {
      const resp = await fetch('/api/catalog', { headers: { accept: 'application/json' } });
      if (!resp.ok) throw new Error('status ' + resp.status);
      const data = await resp.json();
      const projects = (data.projects || []).filter((p) => p.ghost);
      projects.sort((a, b) => a.name.localeCompare(b.name));
      cards.innerHTML = '';
      for (const p of projects) {
        const li = document.createElement('li');
        li.className = 'card';
        const meta =
          !p.protected && p.count != null
            ? `<span class="card-date">${p.count} file${p.count === 1 ? '' : 's'}</span>`
            : '';
        li.innerHTML =
          `<a class="card-link" href="/${encodeURIComponent(p.name)}" aria-label="Open project ${p.name}">` +
          `<div class="card-top">` +
          `<span class="proj-icon" aria-hidden="true">${p.protected ? '🔒' : '📁'}</span>` +
          meta +
          `</div>` +
          `<h3 class="card-title proj-name">${p.name}</h3>` +
          `<p class="card-desc">${p.protected ? 'Protected — password required to view files.' : 'Open — click to view files.'}</p>` +
          `</a>`;
        cards.appendChild(li);
      }
      countEl.textContent = `${projects.length} project${projects.length === 1 ? '' : 's'}`;
      emptyEl.hidden = projects.length !== 0;
    } catch (err) {
      countEl.textContent = 'Could not load ghost projects';
      emptyEl.hidden = false;
      emptyEl.textContent = String(err.message || err);
    }
  })();
</script>
