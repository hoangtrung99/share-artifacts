---
// Catch-all route serving TWO kinds of page (one file avoids dynamic-route collisions):
//   1. kind:'project' at /<project>      — lists the files inside a project (gated by the
//      first-segment middleware for protected projects, so you must log in to even see the list).
//   2. kind:'artifact' at /<project>/<file> — the viewer:
//        - html: full-bleed iframe of the raw artifact + a floating action overlay (Fab).
//        - md:   rendered markdown + the same floating overlay.
//
// Data + protected-set come from src/lib/artifacts.mjs (shared with the home so titles match).
// Pagefind selective indexing via data-pagefind-body is emitted ONLY on public pages — protected
// project listings and protected viewers carry none, so nothing protected enters the public index.
import Base from '../layouts/Base.astro';
import Fab from '../components/Fab.astro';
import { loadArtifacts, protectedProjects } from '../lib/artifacts.mjs';

export async function getStaticPaths() {
  const mdModules = import.meta.glob('../artifacts/**/*.md', { eager: true });
  const artifacts = await loadArtifacts(mdModules);
  const locked = protectedProjects();

  // Per-project listing entries (lean items only — no compiled html / search text).
  const byProject = new Map();
  for (const a of artifacts) {
    if (!byProject.has(a.project)) byProject.set(a.project, []);
    const group = a.routePath.split('/').slice(1, -1).join('/'); // subpath between project and file
    byProject.get(a.project).push({
      title: a.title,
      routePath: a.routePath,
      type: a.type,
      date: a.date ?? null,
      group,
    });
  }
  const projectPaths = [...byProject.entries()].map(([project, items]) => ({
    params: { path: project },
    props: { kind: 'project', project, locked: locked.has(project), items },
  }));

  const artifactPaths = artifacts.map((a) => ({
    params: { path: a.routePath },
    props: { kind: 'artifact', ...a },
  }));

  return [...projectPaths, ...artifactPaths];
}

const props = Astro.props;
const kind = props.kind;

const isArtifact = kind === 'artifact';
const isHtml = isArtifact && props.type === 'html';
const isMd = isArtifact && props.type === 'md';
const isProtected = isArtifact ? props.protected : props.locked;
const ogUrl = isArtifact ? new URL(Astro.url.pathname, Astro.site).href : '';
const toc = isMd ? (props.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3) : [];
const pagefindBody = isArtifact && !isProtected ? true : undefined;

const pageTitle = kind === 'project' ? props.project : props.title;
const pageDesc = kind === 'project' ? `Files in ${props.project}` : props.description;

// Group a project's files by sub-folder for the listing.
let groups = [];
if (kind === 'project') {
  const m = new Map();
  for (const it of props.items) {
    if (!m.has(it.group)) m.set(it.group, []);
    m.get(it.group).push(it);
  }
  groups = [...m.entries()]
    .map(([group, items]) => ({
      group,
      items: items.sort((x, y) =>
        x.date && y.date && x.date !== y.date ? y.date.localeCompare(x.date) : x.title.localeCompare(y.title)
      ),
    }))
    .sort((a, b) => a.group.localeCompare(b.group));
}
---

{kind === 'project' && (
  <Base title={pageTitle} description={pageDesc}>
    <header class="proj-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">🏠 Artifacts</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="proj-name">{props.project}</span>
        {props.locked && <span class="lock"><span aria-hidden="true">🔒</span> Protected</span>}
        {props.locked && (
          <a class="signout" href={`/logout?project=${encodeURIComponent(props.project)}`}>⎋ Sign out</a>
        )}
      </nav>
      <h1 class="proj-h1">{props.project}</h1>
      <div class="proj-filter-wrap">
        <input
          type="search"
          class="proj-filter"
          data-proj-filter
          placeholder="Fuzzy filter files…"
          aria-label="Filter files in this project"
          autocomplete="off"
          spellcheck="false"
        />
        <span class="filter-count" data-filter-count>{props.items.length} file{props.items.length === 1 ? '' : 's'}</span>
      </div>
    </header>

    {groups.map((g) => (
      <section class="proj-group">
        {g.group && <h2 class="proj-group-title">{g.group}</h2>}
        <ul class="file-list">
          {g.items.map((it) => (
            <li data-search={`${it.title} ${it.group} ${it.routePath.split('/').pop()}`.toLowerCase()}>
              <a class="file-link" href={`/${it.routePath}`}>
                <span class={`badge badge-${it.type}`}>{it.type.toUpperCase()}</span>
                <span class="file-title">{it.title}</span>
                {it.date && <span class="file-date">{it.date}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="no-results" data-no-results hidden>No files match your filter.</p>
  </Base>
)}

{isHtml && (
  <Base title={pageTitle} description={pageDesc} fullBleed>
    <div class="viewer-bleed">
      <iframe class="bleed-frame" src={props.rawUrl} title={props.title}></iframe>
    </div>
    <Fab rawUrl={props.rawUrl} downloadName={props.downloadName} project={props.project} type="html" isProtected={isProtected} />
    {/* Public-only: mirror iframed body text into an indexed, screen-reader-only region so
        full-text search works. Protected pages emit nothing -> never in the public index. */}
    {pagefindBody && props.searchText && (
      <div class="sr-only" data-pagefind-body data-pagefind-meta={`title:${props.title}`}>{props.searchText}</div>
    )}
    <meta slot="head" property="og:title" content={props.title} />
    {props.description && <meta slot="head" property="og:description" content={props.description} />}
    <meta slot="head" property="og:type" content="article" />
    <meta slot="head" property="og:url" content={ogUrl} />
  </Base>
)}

{isMd && (
  <Base title={pageTitle} description={pageDesc}>
    <article class="md-view" data-pagefind-body={pagefindBody} data-pagefind-meta={pagefindBody ? `title:${props.title}` : undefined}>
      <header class="viewer-head">
        <p class="type-line">
          <span class="badge badge-md">MD</span>
          {props.date && <span class="date">{props.date}</span>}
        </p>
        <h1>{props.title}</h1>
        {props.description && <p class="lede">{props.description}</p>}
        {props.tags.length > 0 && (
          <p class="tags" aria-label="Tags">{props.tags.map((t) => <span class="tag">{t}</span>)}</p>
        )}
      </header>
      <div class="md-layout" data-has-toc={toc.length > 0 ? 'true' : 'false'}>
        {toc.length > 0 && (
          <aside class="toc" aria-label="Table of contents">
            <p class="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </aside>
        )}
        <div class="md-body"><Fragment set:html={props.html} /></div>
      </div>
    </article>
    <Fab rawUrl={props.rawUrl} downloadName={props.downloadName} project={props.project} type="md" isProtected={isProtected} />
    <meta slot="head" property="og:title" content={props.title} />
    {props.description && <meta slot="head" property="og:description" content={props.description} />}
    <meta slot="head" property="og:type" content="article" />
    <meta slot="head" property="og:url" content={ogUrl} />
  </Base>
)}

<script>
  // Runs on every page from this route; handlers no-op where the buttons are absent.
  const copyBtn = document.querySelector('[data-copy-link]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.setAttribute('data-copied', '1');
        setTimeout(() => copyBtn.removeAttribute('data-copied'), 1300);
      } catch {
        window.prompt('Copy this link:', window.location.href);
      }
    });
  }
  const printBtn = document.querySelector('[data-print]');
  if (printBtn) printBtn.addEventListener('click', () => window.print());

  // Fuzzy filter for the per-project file list (subsequence match + light ranking).
  const pf = document.querySelector('[data-proj-filter]');
  if (pf) {
    const items = Array.from(document.querySelectorAll('.file-list li'));
    const groups = Array.from(document.querySelectorAll('.proj-group'));
    const countEl = document.querySelector('[data-filter-count]');
    const noRes = document.querySelector('[data-no-results]');
    const total = items.length;
    const fuzzy = (q, s) => {
      let h = 0, score = 0, streak = 0;
      for (const ch of q) {
        const i = s.indexOf(ch, h);
        if (i === -1) return -1;            // not a subsequence → no match
        streak = i === h ? streak + 1 : 0;  // reward contiguous runs
        score += 1 + streak * 2 - (i - h) * 0.05;
        h = i + 1;
      }
      return score;
    };
    const apply = () => {
      const q = pf.value.trim().toLowerCase();
      let shown = 0;
      for (const li of items) {
        if (!q) { li.hidden = false; li.style.order = ''; shown++; continue; }
        const sc = fuzzy(q, li.dataset.search || '');
        if (sc < 0) { li.hidden = true; }
        else { li.hidden = false; li.style.order = String(-Math.round(sc * 100)); shown++; }
      }
      for (const g of groups) {
        g.hidden = q ? !g.querySelector('.file-list li:not([hidden])') : false;
      }
      if (countEl) countEl.textContent = q ? `${shown} / ${total}` : `${total} file${total === 1 ? '' : 's'}`;
      if (noRes) noRes.hidden = shown !== 0;
    };
    pf.addEventListener('input', apply);
  }
</script>
