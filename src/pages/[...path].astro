---
// Catch-all route serving TWO kinds of page (one file avoids dynamic-route collisions):
//   1. kind:'project' at /<project>      — lists the files inside a project (gated by the
//      first-segment middleware for protected projects, so you must log in to even see the list).
//   2. kind:'artifact' at /<project>/<file> — the viewer:
//        - html: full-bleed iframe of the raw artifact + a floating action overlay (Fab).
//        - md:   rendered markdown + the same floating overlay.
//
// Data + protected-set come from src/lib/artifacts.mjs (shared with the home so titles match).
// Pagefind selective indexing via data-pagefind-body is emitted ONLY on public pages — protected
// project listings and protected viewers carry none, so nothing protected enters the public index.
import Base from '../layouts/Base.astro';
import Fab from '../components/Fab.astro';
import ShareModal from '../components/ShareModal.astro';
import FileTree from '../components/FileTree.astro';
import { loadArtifacts, protectedProjects } from '../lib/artifacts.mjs';

export async function getStaticPaths() {
  const mdModules = import.meta.glob('../artifacts/**/*.md', { eager: true });
  const artifacts = await loadArtifacts(mdModules);
  const locked = protectedProjects();

  // Per-project listing entries (lean items only — no compiled html / search text).
  const byProject = new Map();
  for (const a of artifacts) {
    if (!byProject.has(a.project)) byProject.set(a.project, []);
    const rest = a.routePath.split('/').slice(1); // segments after the project
    const folder = rest.slice(0, -1).join('/'); // full folder path (all segments except filename)
    byProject.get(a.project).push({
      title: a.title,
      routePath: a.routePath,
      type: a.type,
      date: a.date ?? null,
      sortDate: a.sortDate ?? '',
      folder,
    });
  }
  const projectPaths = [...byProject.entries()].map(([project, items]) => ({
    params: { path: project },
    props: { kind: 'project', project, locked: locked.has(project), items },
  }));

  const artifactPaths = artifacts.map((a) => ({
    params: { path: a.routePath },
    props: { kind: 'artifact', ...a },
  }));

  return [...projectPaths, ...artifactPaths];
}

const props = Astro.props;
const kind = props.kind;

const isArtifact = kind === 'artifact';
const isHtml = isArtifact && props.type === 'html';
const isMd = isArtifact && props.type === 'md';
const isProtected = isArtifact ? props.protected : props.locked;
const ogUrl = isArtifact ? new URL(Astro.url.pathname, Astro.site).href : '';
const toc = isMd ? (props.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3) : [];
// Wrap wide tables so they scroll inside their own box (never overflow the page / under the TOC).
const mdHtml = isMd
  ? props.html.replace(/<table>/g, '<div class="x-scroll"><table>').replace(/<\/table>/g, '</table></div>')
  : '';
const pagefindBody = isArtifact && !isProtected ? true : undefined;

const pageTitle = kind === 'project' ? props.project : props.title;
const pageDesc = kind === 'project' ? `Files in ${props.project}` : props.description;

// Build a nested folder tree from flat items for the project listing.
// Each node: { name, path, files[], children[], count }.
function buildTree(items) {
  const root = { name: '', path: '', files: [], children: new Map(), count: 0 };
  for (const it of items) {
    const parts = it.folder ? it.folder.split('/') : [];
    let node = root;
    let curPath = '';
    for (const part of parts) {
      curPath = curPath ? `${curPath}/${part}` : part;
      if (!node.children.has(part)) {
        node.children.set(part, { name: part, path: curPath, files: [], children: new Map(), count: 0 });
      }
      node = node.children.get(part);
    }
    node.files.push(it);
  }
  // Convert Maps to arrays, compute descendant counts + folder recency, then order siblings.
  const finalize = (node) => {
    // Finalize children FIRST so each child's recency (.date) is known before sorting siblings.
    const kids = [...node.children.values()].map(finalize);
    // Folder recency = newest sortDate among own files AND child-folder recencies (recursive).
    const dates = [...node.files.map((f) => f.sortDate || ''), ...kids.map((c) => c.date)].filter(Boolean);
    node.date = dates.length ? dates.reduce((m, d) => (d > m ? d : m)) : '';
    // Default order matches the default sort chip ('recent'): newest first, name as tiebreak.
    kids.sort((a, b) => (b.date || '').localeCompare(a.date || '') || a.name.localeCompare(b.name));
    node.children = kids;
    node.count = node.files.length + kids.reduce((s, c) => s + c.count, 0);
    return node;
  };
  return finalize(root);
}
let tree = null;
if (kind === 'project') tree = buildTree(props.items);
// Recency of the (root) group = newest sortDate among files sitting directly at the project root.
// Lets the (root) group interleave with sub-folders under the 'recent' sort instead of pinning last.
const rootDate = tree ? tree.files.reduce((m, f) => ((f.sortDate || '') > m ? f.sortDate || '' : m), '') : '';
---

{kind === 'project' && (
  <Base title={pageTitle} description={pageDesc}>
    <header class="proj-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">🏠 Artifacts</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="proj-name">{props.project}</span>
        {props.locked && <span class="lock"><span aria-hidden="true">🔒</span> Protected</span>}
        {props.locked && (
          <button class="share-link" type="button" data-share data-share-project={props.project} data-share-path={`/${encodeURIComponent(props.project)}/`} data-tip="Create share link for this project">📤 Share</button>
        )}
        {props.locked && (
          <a class="signout" href={`/logout?project=${encodeURIComponent(props.project)}`}>⎋ Sign out</a>
        )}
      </nav>
      <h1 class="proj-h1">{props.project}</h1>
      <div class="proj-controls">
        <input
          type="search"
          class="proj-filter"
          data-proj-filter
          placeholder="Fuzzy filter files (title or folder path)…"
          aria-label="Filter files in this project"
          autocomplete="off"
          spellcheck="false"
        />
        <div class="type-chips" role="group" aria-label="Filter by type" data-type-filter>
          <button type="button" class="chip is-active" data-type="all">All</button>
          <button type="button" class="chip" data-type="md">MD</button>
          <button type="button" class="chip" data-type="html">HTML</button>
        </div>
        <div class="sort-chips" role="group" aria-label="Sort by" data-sort-filter>
          <button type="button" class="chip is-active" data-sort="recent">Recent</button>
          <button type="button" class="chip" data-sort="name">Name</button>
          <button type="button" class="chip" data-sort="type">Type</button>
        </div>
        <div class="expand-controls">
          <button type="button" class="chip" data-expand-all>Expand all</button>
          <button type="button" class="chip" data-collapse-all>Collapse all</button>
        </div>
      </div>
      <p class="count" data-filter-count>{props.items.length} file{props.items.length === 1 ? '' : 's'}</p>
    </header>

    {tree.children.length > 0 && <FileTree nodes={tree.children} />}
    {tree.files.length > 0 && (
      <details class="proj-group" data-folder="" data-name="" data-date={rootDate} style="--depth: 0" open>
        <summary class="proj-group-title">
          <span class="grp-chevron" aria-hidden="true">▸</span>
          <span class="grp-name">(root)</span>
          <span class="grp-count">{tree.files.length}</span>
        </summary>
        <ul class="file-list">
          {tree.files.map((it) => (
            <li
              data-search={`${it.title} ${it.routePath}`.toLowerCase()}
              data-type={it.type}
              data-folder={it.folder}
              data-date={it.sortDate || ''}
              data-title={it.title.toLowerCase()}
            >
              <a class="file-link" href={`/${it.routePath}`}>
                <span class={`badge badge-${it.type}`}>{it.type.toUpperCase()}</span>
                <span class="file-title">{it.title}</span>
                {it.date && <span class="file-date">{it.date}</span>}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
    <p class="no-results" data-no-results hidden>No files match your filter.</p>
    {props.locked && <ShareModal />}
  </Base>
)}

{isHtml && (
  <Base title={pageTitle} description={pageDesc} fullBleed>
    <div class="viewer-bleed">
      <iframe class="bleed-frame" src={props.rawUrl} title={props.title}></iframe>
    </div>
    <Fab rawUrl={props.rawUrl} downloadName={props.downloadName} project={props.project} type="html" isProtected={isProtected} label={props.title} routePath={props.routePath} />
    {/* Public-only: mirror iframed body text into an indexed, screen-reader-only region so
        full-text search works. Protected pages emit nothing -> never in the public index. */}
    {pagefindBody && props.searchText && (
      <div class="sr-only" data-pagefind-body data-pagefind-meta={`title:${props.title}`}>{props.searchText}</div>
    )}
    <meta slot="head" property="og:title" content={props.title} />
    {props.description && <meta slot="head" property="og:description" content={props.description} />}
    <meta slot="head" property="og:type" content="article" />
    <meta slot="head" property="og:url" content={ogUrl} />
    {isProtected && <ShareModal />}
  </Base>
)}

{isMd && (
  <Base title={pageTitle} description={pageDesc} fullBleed>
    <div class="md-shell">
    <article class="md-view" data-pagefind-body={pagefindBody} data-pagefind-meta={pagefindBody ? `title:${props.title}` : undefined}>
      <header class="viewer-head">
        <p class="type-line">
          <span class="badge badge-md">MD</span>
          {props.date && <span class="date">{props.date}</span>}
        </p>
        <h1>{props.title}</h1>
        {props.description && <p class="lede">{props.description}</p>}
        {props.tags.length > 0 && (
          <p class="tags" aria-label="Tags">{props.tags.map((t) => <span class="tag">{t}</span>)}</p>
        )}
      </header>
      <div class="md-layout" data-has-toc={toc.length > 0 ? 'true' : 'false'}>
        {toc.length > 0 && (
          <aside class="toc" aria-label="Table of contents">
            <p class="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </aside>
        )}
        <div class="md-body"><Fragment set:html={mdHtml} /></div>
      </div>
    </article>
    </div>
    <Fab rawUrl={props.rawUrl} downloadName={props.downloadName} project={props.project} type="md" isProtected={isProtected} label={props.title} routePath={props.routePath} />
    <meta slot="head" property="og:title" content={props.title} />
    {props.description && <meta slot="head" property="og:description" content={props.description} />}
    <meta slot="head" property="og:type" content="article" />
    <meta slot="head" property="og:url" content={ogUrl} />
    {isProtected && <ShareModal />}
  </Base>
)}

<script>
  // Runs on every page from this route; handlers no-op where the buttons are absent.
  const copyBtn = document.querySelector('[data-copy-link]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyBtn.setAttribute('data-copied', '1');
        setTimeout(() => copyBtn.removeAttribute('data-copied'), 1300);
      } catch {
        window.prompt('Copy this link:', window.location.href);
      }
    });
  }
  const printBtn = document.querySelector('[data-print]');
  if (printBtn) printBtn.addEventListener('click', () => window.print());

  // Per-project controls: fuzzy text + type chips + sort + collapse/expand.
  // Filter state (q, type, sort) syncs to the URL via history.replaceState so filtered
  // views are shareable — the copy-link button already grabs window.location.href.
  const pf = document.querySelector('[data-proj-filter]');
  const groupEls = Array.from(document.querySelectorAll('.proj-group'));
  if (groupEls.length) {
    const items = Array.from(document.querySelectorAll('.file-list li'));
    const countEl = document.querySelector('[data-filter-count]');
    const noRes = document.querySelector('[data-no-results]');
    const typeBtns = Array.from(document.querySelectorAll('[data-type-filter] [data-type]'));
    const sortBtns = Array.from(document.querySelectorAll('[data-sort-filter] [data-sort]'));
    const total = items.length;

    // --- Restore filter state from URL on load ---
    const params = new URLSearchParams(window.location.search);
    let activeType = params.get('type') || 'all';
    let activeSort = params.get('sort') || 'recent';
    if (pf) pf.value = params.get('q') || '';
    typeBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.type === activeType));
    sortBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.sort === activeSort));

    const fuzzy = (q, s) => {
      let h = 0, score = 0, streak = 0;
      for (const ch of q) {
        const i = s.indexOf(ch, h);
        if (i === -1) return -1;
        streak = i === h ? streak + 1 : 0;
        score += 1 + streak * 2 - (i - h) * 0.05;
        h = i + 1;
      }
      return score;
    };

    // --- URL sync: write current filter state to the address bar ---
    const syncUrl = () => {
      const p = new URLSearchParams();
      if (pf?.value.trim()) p.set('q', pf.value.trim());
      if (activeType !== 'all') p.set('type', activeType);
      if (activeSort !== 'recent') p.set('sort', activeSort);
      const qs = p.toString();
      history.replaceState(null, '', qs ? `${window.location.pathname}?${qs}` : window.location.pathname);
    };

    // Recency compare (newest first). Returns 0 when neither side outranks the other (→ tiebreak).
    const cmpRecent = (da, db) => {
      if (da && db && da !== db) return db.localeCompare(da);
      if (da && !db) return -1;
      if (db && !da) return 1;
      return 0;
    };

    // --- Sort: reorder <li> within each <ul> based on active sort mode ---
    const sortList = (ul) => {
      const lis = Array.from(ul.children).filter((el) => el.tagName === 'LI');
      lis.sort((a, b) => {
        if (activeSort === 'recent') {
          const r = cmpRecent(a.dataset.date || '', b.dataset.date || '');
          if (r) return r;
        } else if (activeSort === 'type') {
          if (a.dataset.type !== b.dataset.type) return a.dataset.type.localeCompare(b.dataset.type);
        }
        return (a.dataset.title || '').localeCompare(b.dataset.title || '');
      });
      lis.forEach((li) => ul.appendChild(li));
    };

    // --- Sort: reorder folder <details> groups to match the active sort mode ---
    // 'recent' → newest descendant file first; 'name'/'type' → folder name (the empty-named
    // (root) group sorts last under name, but its recency lets it interleave under 'recent').
    const groupCmp = (a, b) => {
      if (activeSort === 'recent') {
        const r = cmpRecent(a.dataset.date || '', b.dataset.date || '');
        if (r) return r;
      }
      const na = a.dataset.name || '', nb = b.dataset.name || '';
      if (na === nb) return 0;
      if (!na) return 1;
      if (!nb) return -1;
      return na.localeCompare(nb);
    };
    // Reorder only the direct .proj-group children of a container; siblings (header, <ul>,
    // no-results) keep their slots. Groups are a contiguous block, so we re-insert after the
    // element that precedes the first group.
    const reorderGroups = (container) => {
      const groups = Array.from(container.children).filter(
        (el) => el.tagName === 'DETAILS' && el.classList.contains('proj-group')
      );
      if (groups.length < 2) return;
      let ref = groups[0].previousElementSibling;
      groups.sort(groupCmp);
      for (const g of groups) {
        if (ref) ref.insertAdjacentElement('afterend', g);
        else container.insertBefore(g, container.firstChild);
        ref = g;
      }
    };
    // Every distinct parent that holds folder groups (top-level container + each nesting <details>).
    const groupContainers = [...new Set(groupEls.map((g) => g.parentElement).filter(Boolean))];

    const apply = () => {
      const q = (pf?.value || '').trim().toLowerCase();
      const filtering = !!q || activeType !== 'all';
      let shown = 0;
      for (const li of items) {
        const typeOk = activeType === 'all' || li.dataset.type === activeType;
        let textOk = true, score = 0;
        if (q) { score = fuzzy(q, li.dataset.search || ''); textOk = score >= 0; }
        const vis = typeOk && textOk;
        li.hidden = !vis;
        li.style.order = vis && q ? String(-Math.round(score * 100)) : '';
        if (vis) shown++;
      }
      // Sort each file list in place, then reorder folder groups within every container.
      document.querySelectorAll('.file-list').forEach(sortList);
      groupContainers.forEach(reorderGroups);
      // Group visibility: bottom-up (deepest first) so parent checks see settled child state.
      for (const g of [...groupEls].reverse()) {
        const anyVisible =
          !!g.querySelector(':scope > .file-list > li:not([hidden])') ||
          !!g.querySelector(':scope > .proj-group:not([hidden])');
        g.hidden = !anyVisible;
        if (filtering && anyVisible) g.open = true;
      }
      if (countEl) countEl.textContent = filtering ? `${shown} / ${total}` : `${total} file${total === 1 ? '' : 's'}`;
      if (noRes) noRes.hidden = shown !== 0;
      syncUrl();
    };

    pf?.addEventListener('input', apply);
    typeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        activeType = b.dataset.type;
        typeBtns.forEach((x) => x.classList.toggle('is-active', x === b));
        apply();
      })
    );
    sortBtns.forEach((b) =>
      b.addEventListener('click', () => {
        activeSort = b.dataset.sort;
        sortBtns.forEach((x) => x.classList.toggle('is-active', x === b));
        apply();
      })
    );
    document.querySelector('[data-expand-all]')?.addEventListener('click', () =>
      groupEls.forEach((g) => { if (!g.hidden) g.open = true; }));
    document.querySelector('[data-collapse-all]')?.addEventListener('click', () =>
      groupEls.forEach((g) => { g.open = false; }));

    // Initial apply: restore filter state from URL + apply default sort.
    apply();
  }
</script>

<script>
  // --- Custom instant tooltips (data-tip) ---
  // Replaces native title tooltips (which have a ~1s delay) with an instant CSS-driven one.
  const tipEl = document.createElement('div');
  tipEl.className = 'tip';
  tipEl.hidden = true;
  document.body.appendChild(tipEl);

  document.addEventListener('mouseover', (e) => {
    const target = e.target.closest('[data-tip]');
    if (!target) return;
    tipEl.textContent = target.dataset.tip;
    tipEl.hidden = false;
    const r = target.getBoundingClientRect();
    tipEl.style.left = (r.left + r.width / 2 - tipEl.offsetWidth / 2) + 'px';
    tipEl.style.top = (r.bottom + 6) + 'px';
  });
  document.addEventListener('mouseout', (e) => {
    if (e.target.closest('[data-tip]')) tipEl.hidden = true;
  });

  // --- Share link modal ---
  const shareBtns = document.querySelectorAll('[data-share]');
  const shareModal = document.getElementById('share-modal');
  if (shareBtns.length && shareModal) {
    let currentProject = '', currentPath = '';

    shareBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        currentProject = btn.dataset.shareProject || '';
        currentPath = btn.dataset.sharePath || '';
        // Reset modal state
        shareModal.hidden = false;
        shareModal.querySelector('[data-share-result]').hidden = true;
        shareModal.querySelector('[data-share-error]').hidden = true;
        shareModal.querySelector('[data-share-generate]').hidden = false;
        shareModal.querySelector('[data-share-generate]').textContent = 'Generate link';
        shareModal.querySelector('[data-share-ttl]').value = '30d';
      });
    });

    shareModal.querySelector('[data-share-close]').addEventListener('click', () => {
      shareModal.hidden = true;
    });
    shareModal.addEventListener('click', (e) => {
      if (e.target === shareModal) shareModal.hidden = true;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !shareModal.hidden) shareModal.hidden = true;
    });

    const generateBtn = shareModal.querySelector('[data-share-generate]');
    const resultRow = shareModal.querySelector('[data-share-result]');
    const urlInput = shareModal.querySelector('#share-url');
    const errorEl = shareModal.querySelector('[data-share-error]');

    generateBtn.addEventListener('click', async () => {
      generateBtn.disabled = true;
      generateBtn.textContent = 'Generating…';
      errorEl.hidden = true;
      const ttl = shareModal.querySelector('[data-share-ttl]').value;
      try {
        const resp = await fetch('/share', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ project: currentProject, path: currentPath, ttl }),
        });
        const data = await resp.json();
        if (!resp.ok) throw new Error(data.error || 'Failed to create share link');
        urlInput.value = data.url;
        resultRow.hidden = false;
        generateBtn.hidden = true;
      } catch (err) {
        errorEl.textContent = err.message || 'Something went wrong.';
        errorEl.hidden = false;
        generateBtn.disabled = false;
        generateBtn.textContent = 'Generate link';
      }
    });

    shareModal.querySelector('[data-share-copy]').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(urlInput.value);
        const copyBtn = shareModal.querySelector('[data-share-copy]');
        copyBtn.textContent = 'Copied!';
        setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1300);
      } catch {
        urlInput.select();
        document.execCommand('copy');
      }
    });
  }
</script>
