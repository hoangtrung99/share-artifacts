---
// Viewer route — one page per artifact at /<project>/<path> (no extension).
//
// Data comes from src/lib/artifacts.mjs (shared with the gallery so titles never drift).
// Markdown is rendered inline; HTML is iframed from the raw copy that prepare-static.mjs
// places at /<project>/<path>.html (kept off Vite's asset graph — see the lib comment).
//
// import.meta.glob must live HERE: it only resolves relative to the importing file. We
// pass the result into loadArtifacts() which does the rest of the enumeration.
import Base from '../layouts/Base.astro';
import { loadArtifacts } from '../lib/artifacts.mjs';

export async function getStaticPaths() {
  const mdModules = import.meta.glob('../artifacts/**/*.md', { eager: true });
  const artifacts = await loadArtifacts(mdModules);
  return artifacts.map((a) => ({
    params: { path: a.routePath },
    props: a,
  }));
}

const { type, project, rawUrl, downloadName, title, description, tags, date, html, headings, searchText } = Astro.props;
const isProtected = Astro.props.protected;
const ogUrl = new URL(Astro.url.pathname, Astro.site).href;

// Only h2/h3 make a useful table of contents; skip the page's own h1.
const toc = (headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);

// Pagefind selective indexing: tag the content region with data-pagefind-body ONLY on public
// pages. Protected pages carry no such attribute, so Pagefind (which indexes default-exclude
// once any page uses data-pagefind-body) drops them from the public index entirely — fail-closed.
const pagefindBody = isProtected ? undefined : true;
---

<Base title={title} description={description}>
  <article class="viewer" data-type={type} data-pagefind-body={pagefindBody} data-pagefind-meta={pagefindBody ? `title:${title}` : undefined}>
    <nav class="toolbar" aria-label="Artifact actions">
      <div class="toolbar-left">
        <a class="btn btn-ghost" href="/" aria-label="Back to gallery">
          <span aria-hidden="true">←</span> Back
        </a>
        <span class="toolbar-crumb">
          <span class="crumb-project">{project}</span>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-title">{title}</span>
        </span>
      </div>
      <div class="toolbar-right">
        <a class="btn" href={rawUrl} download={downloadName} aria-label={`Download ${downloadName}`}>
          <span aria-hidden="true">⬇</span> Download
        </a>
        <button class="btn" type="button" data-copy-link aria-label="Copy link to this artifact">
          <span aria-hidden="true">🔗</span> <span data-copy-label>Copy link</span>
        </button>
        {type === 'md' && (
          <button class="btn" type="button" data-print aria-label="Print or save as PDF">
            <span aria-hidden="true">🖨</span> Print
          </button>
        )}
        <a class="btn" href={rawUrl} target="_blank" rel="noopener" aria-label="Open raw file in a new tab">
          <span aria-hidden="true">⤢</span> Open raw
        </a>
        {isProtected && (
          <a class="btn" href={`/logout?project=${encodeURIComponent(project)}`} aria-label="Sign out of this project">
            <span aria-hidden="true">⎋</span> Sign out
          </a>
        )}
      </div>
    </nav>

    <header class="viewer-head">
      <p class="type-line">
        <span class={`badge badge-${type}`}>{type.toUpperCase()}</span>
        {date && <span class="date">{date}</span>}
      </p>
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      {tags.length > 0 && (
        <p class="tags" aria-label="Tags">
          {tags.map((t) => <span class="tag">{t}</span>)}
        </p>
      )}
    </header>

    {type === 'md' && (
      <div class="md-layout" data-has-toc={toc.length > 0 ? 'true' : 'false'}>
        {toc.length > 0 && (
          <aside class="toc" aria-label="Table of contents">
            <p class="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
              ))}
            </ul>
          </aside>
        )}
        <div class="md-body">
          <Fragment set:html={html} />
        </div>
      </div>
    )}

    {type === 'html' && (
      <div class="html-wrap">
        <iframe class="html-frame" src={rawUrl} title={title} loading="lazy"></iframe>
        <p class="html-hint">
          Embedded view. <a href={rawUrl} target="_blank" rel="noopener">Open fullscreen ↗</a>
        </p>
        {/* The iframe body is invisible to Pagefind. For PUBLIC HTML artifacts we mirror the
            extracted body text here (off-screen, not display:none so Pagefind still reads it)
            purely so full-text search works. Protected pages emit nothing (searchText === ''). */}
        {searchText && <div class="sr-only" aria-hidden="true">{searchText}</div>}
      </div>
    )}
  </article>

  <script>
    const copyBtn = document.querySelector('[data-copy-link]');
    if (copyBtn) {
      const label = copyBtn.querySelector('[data-copy-label]');
      const original = label ? label.textContent : '';
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (label) {
            label.textContent = 'Copied';
            setTimeout(() => { label.textContent = original; }, 1500);
          }
        } catch {
          // Clipboard API can fail on insecure origins; fall back to a prompt.
          window.prompt('Copy this link:', window.location.href);
        }
      });
    }
    const printBtn = document.querySelector('[data-print]');
    if (printBtn) printBtn.addEventListener('click', () => window.print());
  </script>

  <meta slot="head" property="og:title" content={title} />
  {description && <meta slot="head" property="og:description" content={description} />}
  <meta slot="head" property="og:type" content="article" />
  <meta slot="head" property="og:url" content={ogUrl} />
</Base>
