---
// Home — lists PROJECT FOLDERS only (never individual files).
//
// Privacy: protected projects must not reveal their file names/titles on the public home.
// So the home enumerates projects (folder + lock badge) and links into /<project>/; the actual
// file list lives on the per-project page, which the first-segment middleware gates for protected
// projects. File count is shown only for PUBLIC projects (a count would hint at protected size).
// Pagefind search stays (public-only index — protected viewers carry no data-pagefind-body).
import Base from '../layouts/Base.astro';
import { loadArtifacts, protectedProjects, ghostProjects } from '../lib/artifacts.mjs';

const mdModules = import.meta.glob('../artifacts/**/*.md', { eager: true });
const artifacts = await loadArtifacts(mdModules);
const locked = protectedProjects();
const ghosts = ghostProjects();

const counts = new Map();
for (const a of artifacts) {
  if (ghosts.has(a.project)) continue; // ghost projects are hidden from home
  counts.set(a.project, (counts.get(a.project) ?? 0) + 1);
}

// Public projects first, then locked; alpha within each.
const projects = [...counts.entries()]
  .map(([project, count]) => ({ project, count, locked: locked.has(project) }))
  .sort((a, b) => (a.locked === b.locked ? a.project.localeCompare(b.project) : a.locked ? 1 : -1));
---

<Base title="Artifacts" description="Shared artifacts — browse by project.">
  <header class="gallery-head">
    <h1>Artifacts</h1>
    <p class="lede">Browse by project. Protected projects need a password to open their files.</p>
    <div id="search" class="search" aria-label="Search public artifacts"></div>
    <noscript><p class="search-fallback">Search needs JavaScript. Browse the projects below.</p></noscript>
    <p class="count">{projects.length} project{projects.length === 1 ? '' : 's'}</p>
  </header>

  <ul class="cards">
    {projects.map((p) => (
      <li class="card">
        <a class="card-link" href={`/${encodeURIComponent(p.project)}`} aria-label={`Open project ${p.project}`}>
          <div class="card-top">
            <span class="proj-icon" aria-hidden="true">{p.locked ? '🔒' : '📁'}</span>
            {!p.locked && <span class="card-date">{p.count} file{p.count === 1 ? '' : 's'}</span>}
          </div>
          <h3 class="card-title proj-name">{p.project}</h3>
          <p class="card-desc">{p.locked ? 'Protected — password required to view files.' : 'Open — click to view files.'}</p>
        </a>
      </li>
    ))}
  </ul>

  {/* Pagefind UI (assets generated by `pagefind --site dist` after astro build). Public-only index. */}
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') return; // no index on dev server
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: { placeholder: 'Search public artifacts…' },
      });
    });
  </script>
</Base>
