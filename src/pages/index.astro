---
// Home gallery — thin shell. Project list is fetched client-side from /api/catalog
// (R2-backed). No build-time artifact enumeration.
import Base from '../layouts/Base.astro';
---

<Base title="Artifacts" description="Shared artifacts — browse by project.">
  <header class="gallery-head">
    <h1>Artifacts</h1>
    <p class="lede">Browse by project. Protected projects need a password to open their files.</p>
    <div class="proj-controls" style="margin-top:1rem">
      <input
        type="search"
        class="proj-filter"
        id="gallery-filter"
        placeholder="Filter projects…"
        aria-label="Filter projects"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <p class="count" id="gallery-count">Loading projects…</p>
  </header>

  <ul class="cards" id="gallery-cards"></ul>
  <p class="no-results" id="gallery-empty" hidden>No projects match your filter.</p>
  <p class="no-results" id="gallery-error" hidden></p>
</Base>

<script is:inline>
  (async function () {
    const cards = document.getElementById('gallery-cards');
    const countEl = document.getElementById('gallery-count');
    const emptyEl = document.getElementById('gallery-empty');
    const errorEl = document.getElementById('gallery-error');
    const filterEl = document.getElementById('gallery-filter');
    let projects = [];

    function render(list) {
      cards.innerHTML = '';
      for (const p of list) {
        const li = document.createElement('li');
        li.className = 'card';
        li.dataset.name = p.name.toLowerCase();
        const countLabel =
          p.protected || p.count == null
            ? p.protected
              ? 'Protected — password required to view files.'
              : 'Open — click to view files.'
            : 'Open — click to view files.';
        const meta =
          !p.protected && p.count != null
            ? `<span class="card-date">${p.count} file${p.count === 1 ? '' : 's'}</span>`
            : '';
        li.innerHTML =
          `<a class="card-link" href="/${encodeURIComponent(p.name)}" aria-label="Open project ${p.name}">` +
          `<div class="card-top">` +
          `<span class="proj-icon" aria-hidden="true">${p.protected ? '🔒' : '📁'}</span>` +
          meta +
          `</div>` +
          `<h3 class="card-title proj-name">${p.name}</h3>` +
          `<p class="card-desc">${countLabel}</p>` +
          `</a>`;
        cards.appendChild(li);
      }
      countEl.textContent = `${list.length} project${list.length === 1 ? '' : 's'}`;
      emptyEl.hidden = list.length !== 0;
    }

    function applyFilter() {
      const q = (filterEl.value || '').trim().toLowerCase();
      const filtered = q
        ? projects.filter((p) => p.name.toLowerCase().includes(q))
        : projects;
      // Hide non-matching cards without re-fetch
      const set = new Set(filtered.map((p) => p.name.toLowerCase()));
      let shown = 0;
      for (const li of cards.querySelectorAll('.card')) {
        const vis = set.has(li.dataset.name);
        li.hidden = !vis;
        if (vis) shown++;
      }
      countEl.textContent = q
        ? `${shown} / ${projects.length}`
        : `${projects.length} project${projects.length === 1 ? '' : 's'}`;
      emptyEl.hidden = shown !== 0;
    }

    try {
      const resp = await fetch('/api/catalog', { headers: { accept: 'application/json' } });
      if (!resp.ok) throw new Error('Catalog request failed (' + resp.status + ')');
      const data = await resp.json();
      projects = Array.isArray(data.projects) ? data.projects : [];
      // Public gallery: omit ghosts (API already does); sort public first
      projects.sort((a, b) =>
        a.protected === b.protected ? a.name.localeCompare(b.name) : a.protected ? 1 : -1,
      );
      render(projects);
      filterEl.addEventListener('input', applyFilter);
    } catch (err) {
      countEl.textContent = 'Could not load projects';
      errorEl.hidden = false;
      errorEl.textContent =
        (err && err.message) ||
        'Failed to load catalog. Is the site deployed with R2 bindings?';
    }
  })();
</script>
