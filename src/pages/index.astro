---
// Gallery (home) — every artifact grouped by project.
//
// Data + protected-set come from src/lib/artifacts.mjs (the same enumeration the viewer
// uses, so titles match). Full-text search is Pagefind: the UI mounts into #search at runtime
// from the index built into /pagefind after `astro build`. Indexing scope is controlled by
// data-pagefind-body, which is emitted ONLY on public viewer pages (see [...path].astro), so
// protected artifact bodies never enter the public index — fail-closed.
// Protected projects show title + lock badge but NOT their description (see card markup).
import Base from '../layouts/Base.astro';
import { loadArtifacts, protectedProjects } from '../lib/artifacts.mjs';

const mdModules = import.meta.glob('../artifacts/**/*.md', { eager: true });
const artifacts = await loadArtifacts(mdModules);
const locked = protectedProjects();

// Group by project; sort artifacts within a group by date desc (undated last), then title.
const byProject = new Map();
for (const a of artifacts) {
  if (!byProject.has(a.project)) byProject.set(a.project, []);
  byProject.get(a.project).push(a);
}
const sortArtifacts = (list) =>
  list.sort((x, y) => {
    if (x.date && y.date && x.date !== y.date) return y.date.localeCompare(x.date);
    if (x.date && !y.date) return -1;
    if (!x.date && y.date) return 1;
    return x.title.localeCompare(y.title);
  });

// Project sections sorted alphabetically; public projects before locked is not required,
// alpha keeps it predictable.
const groups = [...byProject.entries()]
  .map(([project, list]) => ({
    project,
    locked: locked.has(project),
    items: sortArtifacts(list),
  }))
  .sort((a, b) => a.project.localeCompare(b.project));

const total = artifacts.length;
---

<Base title="Artifacts" description="Shared artifacts — rendered reports, investigations, and explainers.">
  <header class="gallery-head">
    <h1>Artifacts</h1>
    <p class="lede">Shared reports, investigations, and explainers — every link stays stable.</p>
    <div id="search" class="search" aria-label="Search artifacts"></div>
    <noscript>
      <p class="search-fallback">Search needs JavaScript. Browse the projects below.</p>
    </noscript>
    <p class="count">{total} artifact{total === 1 ? '' : 's'} across {groups.length} project{groups.length === 1 ? '' : 's'}</p>
  </header>

  {groups.map((group) => (
    <section class="project" aria-labelledby={`proj-${group.project}`}>
      <h2 id={`proj-${group.project}`} class="project-title">
        {group.project}
        {group.locked && (
          <span class="lock" title="Protected — password required" aria-label="Protected project">
            <span aria-hidden="true">🔒</span> Protected
          </span>
        )}
      </h2>
      <ul class="cards">
        {group.items.map((a) => (
          <li class="card">
            <a class="card-link" href={`/${a.routePath}`}>
              <div class="card-top">
                <span class={`badge badge-${a.type}`}>{a.type.toUpperCase()}</span>
                {a.date && <span class="card-date">{a.date}</span>}
              </div>
              <h3 class="card-title">{a.title}</h3>
              {/* Description is withheld for protected projects so private infra/incident
                  summaries never render on the public home page. Title + lock badge only. */}
              {!group.locked && a.description && <p class="card-desc">{a.description}</p>}
              {a.tags.length > 0 && (
                <p class="card-tags">
                  {a.tags.map((t) => <span class="tag">{t}</span>)}
                </p>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {/* Pagefind UI. Assets are generated by `pagefind --site dist` AFTER `astro build`, so they
      live at /pagefind/* in the deployed output (absent during dev). Reference them by absolute
      path — never through Vite — and mount the UI into #search on load. */}
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI === 'undefined') return; // dev server has no index yet
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        resetStyles: false,
        translations: { placeholder: 'Search artifacts…' },
      });
    });
  </script>
</Base>
