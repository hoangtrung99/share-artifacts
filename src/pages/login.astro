---
// Login page — served as a static asset at /login. GET requests land here (functions/login.js
// only handles POST, so GET falls through to this page).
//
// This page is rendered once at build time and cannot read per-request query params in
// frontmatter. So `project`, `next` and `error` are read CLIENT-SIDE from location.search and
// injected into the form (hidden fields) + the visible project name + the error state.
// The form POSTs back to /login (handled by functions/login.js).
import Base from '../layouts/Base.astro';
import { icon, themePickerButton } from '../../functions/_ui.js';
---

<Base title="Sign in — Artifacts" description="Password required to view this protected project.">
  <a class="skip-link" href="#main-login">Skip to content</a>

  <header class="topbar" data-topbar>
    <div class="topbar-inner">
      <a class="brand" href="/" aria-label="Artifacts — home">
        <span class="brand-mark" aria-hidden="true">A</span>
        <span>Artifacts</span>
        <span class="brand-host">artifacts.hoangtrung.dev</span>
      </a>
      <span class="topbar-spacer"></span>
      <div class="topbar-actions" set:html={themePickerButton()} />
    </div>
  </header>

  <main class="login-wrap" id="main-login" tabindex="-1">
    <section class="login-card" aria-labelledby="login-title">
      <h1 id="login-title">Sign in to <em data-project>this project</em></h1>
      <p class="login-lede">This project is password protected. Enter the password to view its artifacts.</p>

      <p class="form-error" id="login-error" role="alert" hidden>
        <Fragment set:html={icon('alert')} />
        <span>That password doesn’t match. Try again.</span>
      </p>

      <form class="login-form" method="POST" action="/login">
        <input type="hidden" name="project" data-field-project value="" />
        <input type="hidden" name="next" data-field-next value="/" />
        <div class="field">
          <label class="field-label" for="password">Password</label>
          <div class="input-wrap">
            <input
              class="text-input"
              id="password"
              name="password"
              type="password"
              required
              autofocus
              autocomplete="current-password"
              aria-describedby="login-error"
            />
            <button class="pw-toggle" type="button" data-pw-toggle aria-label="Show password" aria-pressed="false">
              <Fragment set:html={icon('eye', 'icon icon-on')} />
              <Fragment set:html={icon('eye-off', 'icon icon-off')} />
            </button>
          </div>
        </div>
        <button class="btn btn--primary btn--block login-submit" type="submit">Continue</button>
      </form>

      <p class="login-note">Access lasts 180 days on this device. <a href="/">Back to gallery</a></p>
    </section>
  </main>

  <script is:inline>
    (function () {
      'use strict';

      const params = new URLSearchParams(location.search);
      const project = (params.get('project') || '').trim();
      const nextParam = params.get('next') || '';
      // Only keep same-origin absolute paths in the hidden next field (defense in depth; the
      // function re-sanitizes server-side too).
      const next = nextParam.startsWith('/') && nextParam[1] !== '/'
        ? nextParam
        : (project ? '/' + project + '/' : '/');
      const hasError = params.get('error') === '1';

      if (project) {
        for (const el of document.querySelectorAll('[data-project]')) el.textContent = project;
        document.title = 'Sign in to ' + project + ' — Artifacts';
      }

      const projectField = document.querySelector('[data-field-project]');
      if (projectField) projectField.value = project;
      const nextField = document.querySelector('[data-field-next]');
      if (nextField) nextField.value = next;

      const input = document.getElementById('password');
      const error = document.getElementById('login-error');

      if (hasError) {
        if (error) error.hidden = false;
        if (input) {
          input.setAttribute('aria-invalid', 'true');
          input.focus();
        }
      }

      if (input) {
        input.addEventListener('input', function () {
          input.removeAttribute('aria-invalid');
        });
      }

      // Show/hide password: flip the input type + the eye icons (CSS keys off aria-pressed).
      const toggle = document.querySelector('[data-pw-toggle]');
      if (input && toggle) {
        toggle.addEventListener('click', function () {
          const show = input.type === 'password';
          input.type = show ? 'text' : 'password';
          toggle.setAttribute('aria-pressed', String(show));
          toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
          input.focus();
        });
      }
    })();
  </script>
</Base>
