---
// Styled login page — served as a static asset at /login. GET requests land here (the
// login.js function only handles POST, so GET falls through to this page).
//
// This is a STATIC page: it is rendered once at build time and cannot read per-request query
// params in frontmatter. So `project`, `next`, and the `error` flag are read CLIENT-SIDE from
// location.search and injected into the form (hidden fields) + the visible project name + the
// error message. The form POSTs back to /login (handled by functions/login.js).
import Base from '../layouts/Base.astro';
---

<Base title="Sign in — Artifacts" description="Password required to view this protected project.">
  <section class="login" aria-labelledby="login-title">
    <div class="login-card">
      <p class="login-kicker">
        <span class="lock-dot" aria-hidden="true">🔒</span> Protected project
      </p>
      <h1 id="login-title">Sign in to <span class="login-project" data-project>this project</span></h1>
      <p class="login-lede">Enter the password to view <span class="login-project-inline" data-project>this project</span>.</p>

      <p class="login-error" data-error role="alert" hidden>
        Incorrect password. Please try again.
      </p>

      <form class="login-form" method="POST" action="/login" autocomplete="off">
        <input type="hidden" name="project" data-field-project value="" />
        <input type="hidden" name="next" data-field-next value="/" />
        <label class="login-label" for="password">Password</label>
        <div class="login-input-wrap">
          <input
            class="login-input"
            id="password"
            name="password"
            type="password"
            required
            autofocus
            autocomplete="current-password"
            aria-describedby="login-note"
          />
          <button type="button" class="pw-toggle" data-pw-toggle aria-label="Show password" aria-pressed="false">
            <svg class="icon-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
            <svg class="icon-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
              <line x1="1" y1="1" x2="23" y2="23" />
            </svg>
          </button>
        </div>
        <button class="btn btn-primary login-submit" type="submit">Sign in</button>
      </form>

      <p class="login-note" id="login-note">
        Access is granted for 180 days on this device. <a href="/">Back to gallery</a>
      </p>
    </div>
  </section>

  <script is:inline>
    // Read per-request context from the URL (static page → no server-side params).
    const params = new URLSearchParams(location.search);
    const rawProject = params.get('project') || '';
    const project = rawProject.trim();
    const next = params.get('next') || (project ? '/' + project + '/' : '/');
    const hasError = params.get('error') === '1';

    if (project) {
      for (const el of document.querySelectorAll('[data-project]')) el.textContent = project;
      document.title = 'Sign in to ' + project + ' — Artifacts';
    }
    const pf = document.querySelector('[data-field-project]');
    if (pf) pf.value = project;
    const nf = document.querySelector('[data-field-next]');
    // Only keep same-origin absolute paths in the hidden next field (defense in depth; the
    // function re-sanitizes server-side too).
    if (nf) nf.value = next.startsWith('/') && next[1] !== '/' ? next : (project ? '/' + project + '/' : '/');

    const err = document.querySelector('[data-error]');
    if (err && hasError) err.hidden = false;

    // Show/hide password toggle: flips the input type + the eye/eye-off icon (CSS keys off aria-pressed).
    const pwInput = document.getElementById('password');
    const pwToggle = document.querySelector('[data-pw-toggle]');
    if (pwInput && pwToggle) {
      pwToggle.addEventListener('click', () => {
        const show = pwInput.type === 'password';
        pwInput.type = show ? 'text' : 'password';
        pwToggle.setAttribute('aria-pressed', String(show));
        pwToggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
        pwInput.focus();
      });
    }
  </script>
</Base>
