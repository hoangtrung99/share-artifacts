<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Circuit Breaker → Slack: Why Some Alerts Are Missed (and the Fix)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ============ THEME (Blueprint) ============ */
  :root {
    --font-body: 'IBM Plex Sans', system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', 'SF Mono', Consolas, monospace;

    --bg: #eef2f8;
    --surface: #ffffff;
    --surface-elevated: #ffffff;
    --surface2: #f4f7fb;
    --border: rgba(20, 45, 85, 0.12);
    --border-bright: rgba(20, 45, 85, 0.22);
    --text: #14233b;
    --text-dim: #5a6b86;

    --accent: #1e477e;       /* blueprint blue */
    --accent-dim: rgba(30, 71, 126, 0.10);
    --reliable: #0f766e;     /* teal — channel 2 */
    --reliable-dim: rgba(15, 118, 110, 0.12);
    --danger: #b91c1c;       /* red — the bug */
    --danger-dim: rgba(185, 28, 28, 0.10);
    --warn: #b45309;         /* amber */
    --warn-dim: rgba(180, 83, 9, 0.12);

    --green: #0f766e; --green-dim: rgba(15,118,110,0.12);
    --red: #b91c1c;   --red-dim: rgba(185,28,28,0.10);
    --orange: #b45309; --orange-dim: rgba(180,83,9,0.12);
    --amber: #b45309;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a1120;
      --surface: #111b30;
      --surface-elevated: #15223b;
      --surface2: #0e182b;
      --border: rgba(255, 255, 255, 0.09);
      --border-bright: rgba(255, 255, 255, 0.18);
      --text: #dde7f6;
      --text-dim: #8aa0c0;

      --accent: #6aa3f0;
      --accent-dim: rgba(106, 163, 240, 0.14);
      --reliable: #2dd4bf;
      --reliable-dim: rgba(45, 212, 191, 0.14);
      --danger: #f87171;
      --danger-dim: rgba(248, 113, 113, 0.14);
      --warn: #fbbf24;
      --warn-dim: rgba(251, 191, 36, 0.14);

      --green: #2dd4bf; --green-dim: rgba(45,212,191,0.14);
      --red: #f87171;   --red-dim: rgba(248,113,113,0.14);
      --orange: #fbbf24; --orange-dim: rgba(251,191,36,0.14);
      --amber: #fbbf24;
    }
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  .grid > *, .flex > * { min-width: 0; }

  body {
    background-color: var(--bg);
    /* faint blueprint grid */
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--text);
    font-family: var(--font-body);
    line-height: 1.6;
    overflow-wrap: break-word;
    padding-bottom: 80px;
  }

  /* ============ ANIMATION ============ */
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeScale { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: scale(1); } }
  .animate { animation: fadeUp 0.45s ease-out both; animation-delay: calc(var(--i, 0) * 0.06s); }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-delay: 0ms !important; transition-duration: 0.01ms !important; }
  }

  /* ============ NAV ============ */
  .topnav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .topnav__inner {
    max-width: 1080px; margin: 0 auto; padding: 10px 32px;
    display: flex; gap: 8px; flex-wrap: wrap; align-items: center;
  }
  .topnav__brand {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent);
    margin-right: auto;
  }
  .topnav a {
    font-family: var(--font-mono); font-size: 11px; color: var(--text-dim);
    text-decoration: none; padding: 4px 9px; border-radius: 6px;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .topnav a:hover { background: var(--accent-dim); color: var(--accent); }

  /* ============ LAYOUT ============ */
  .container { max-width: 1080px; margin: 0 auto; padding: 40px 32px 0; }

  header.page { margin-bottom: 36px; }
  .eyebrow {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 2px; color: var(--accent);
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(28px, 4.2vw, 42px); font-weight: 700; letter-spacing: -1px;
    line-height: 1.1; margin-bottom: 12px; text-wrap: balance;
  }
  .meta-line {
    font-family: var(--font-mono); font-size: 12px; color: var(--text-dim);
    display: flex; gap: 16px; flex-wrap: wrap;
  }
  .meta-line span::before { content: '› '; color: var(--accent); }

  section.block { margin: 44px 0; scroll-margin-top: 64px; }

  .section-label {
    font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 1.5px; color: var(--accent);
    margin-bottom: 14px; display: flex; align-items: center; gap: 9px;
  }
  .section-label::before {
    content: ''; width: 9px; height: 9px; border-radius: 2px;
    background: currentColor; transform: rotate(45deg);
  }
  h2 { font-size: 23px; font-weight: 700; letter-spacing: -0.4px; margin-bottom: 14px; }
  h3 { font-size: 15px; font-weight: 600; margin: 18px 0 8px; }
  p { margin-bottom: 12px; }
  p.lead { font-size: 17px; line-height: 1.6; color: var(--text); margin-bottom: 20px; max-width: 80ch; }
  .muted { color: var(--text-dim); }

  code {
    font-family: var(--font-mono); font-size: 0.86em;
    background: var(--accent-dim); color: var(--accent);
    padding: 1px 6px; border-radius: 4px; word-break: break-word;
  }

  /* ============ CARDS ============ */
  .ve-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; padding: 20px 22px;
  }
  .ve-card--hero {
    background: color-mix(in srgb, var(--surface) 90%, var(--accent) 10%);
    box-shadow: 0 6px 28px rgba(10, 25, 55, 0.10), 0 1px 3px rgba(0,0,0,0.04);
    border-color: color-mix(in srgb, var(--border) 40%, var(--accent) 60%);
    padding: 26px 28px;
  }

  /* KPI row */
  .kpi-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-top: 20px; }
  .kpi-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; padding: 16px 18px;
    animation: fadeScale 0.4s ease-out both; animation-delay: calc(var(--i,0) * 0.08s);
  }
  .kpi-card__value { font-size: 26px; font-weight: 700; letter-spacing: -0.5px; line-height: 1.15; font-variant-numeric: tabular-nums; }
  .kpi-card__value.ok { color: var(--reliable); }
  .kpi-card__value.bad { color: var(--danger); }
  .kpi-card__label { font-family: var(--font-mono); font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.2px; color: var(--text-dim); margin-top: 7px; line-height: 1.5; }

  /* ============ CALLOUT ============ */
  .callout { padding: 16px 20px; border-radius: 10px; border-left: 4px solid var(--cb, var(--accent)); background: var(--cbg, var(--accent-dim)); margin: 18px 0; }
  .callout--bug    { --cb: var(--danger);   --cbg: var(--danger-dim); }
  .callout--ok     { --cb: var(--reliable); --cbg: var(--reliable-dim); }
  .callout--warn   { --cb: var(--warn);     --cbg: var(--warn-dim); }
  .callout--info   { --cb: var(--accent);   --cbg: var(--accent-dim); }
  .callout__title { font-weight: 700; margin-bottom: 6px; color: var(--cb, var(--accent)); font-size: 14px; }
  .callout strong { color: var(--text); }
  .callout p:last-child { margin-bottom: 0; }

  /* ============ LISTS ============ */
  ul.clean, ol.clean { list-style: none; padding-left: 0; }
  ul.clean li, ol.clean li { padding-left: 22px; position: relative; margin-bottom: 9px; }
  ul.clean li::before { content: '›'; position: absolute; left: 4px; color: var(--accent); font-weight: 700; }
  ol.clean { counter-reset: it; }
  ol.clean li { counter-increment: it; }
  ol.clean li::before { content: counter(it); position: absolute; left: 0; top: 0; color: var(--accent); font-family: var(--font-mono); font-weight: 600; font-size: 12px; }

  /* ============ MERMAID ============ */
  .diagram-shell { position: relative; }
  .diagram-shell__hint { font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); margin-bottom: 8px; opacity: 0.75; }
  .mermaid-wrap {
    position: relative; background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; padding: 28px 20px; overflow: auto;
    display: flex; justify-content: center; align-items: center; min-height: 420px; cursor: grab;
  }
  .mermaid-wrap.is-panning { cursor: grabbing; user-select: none; }
  .zoom-controls { position: absolute; top: 8px; right: 8px; display: flex; gap: 2px; z-index: 10; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 2px; }
  .zoom-controls button { width: 28px; height: 28px; border: none; background: transparent; color: var(--text-dim); font-family: var(--font-mono); font-size: 14px; cursor: pointer; border-radius: 4px; display: flex; align-items: center; justify-content: center; transition: background 0.15s ease, color 0.15s ease; }
  .zoom-controls button:hover { background: var(--border); color: var(--text); }
  .mermaid-viewport { position: relative; overflow: hidden; width: 100%; height: 100%; min-height: 320px; }
  .mermaid-canvas { position: absolute; top: 0; left: 0; }
  .zoom-label { font-family: var(--font-mono); font-size: 10px; color: var(--text-dim); padding: 0 6px; white-space: nowrap; }
  .mermaid .nodeLabel { font-family: var(--font-body) !important; font-size: 15px !important; }
  .mermaid .edgeLabel { font-family: var(--font-mono) !important; font-size: 12px !important; }

  .legend { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 14px; }
  .legend-item { display: flex; align-items: center; gap: 7px; font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); }
  .legend-swatch { width: 13px; height: 13px; border-radius: 3px; flex-shrink: 0; }

  /* ============ TABLE ============ */
  .table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; line-height: 1.5; }
  .data-table thead { position: sticky; top: 0; z-index: 2; }
  .data-table th { background: var(--surface2); font-family: var(--font-mono); font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-dim); text-align: left; padding: 11px 14px; border-bottom: 2px solid var(--border-bright); white-space: nowrap; }
  .data-table td { padding: 11px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .data-table tbody tr:nth-child(even) { background: var(--surface2); }
  .data-table tbody tr:last-child td { border-bottom: none; }
  .data-table code { font-size: 11px; }
  .data-table small { display: block; color: var(--text-dim); font-size: 11px; margin-top: 2px; }
  .num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--font-mono); white-space: nowrap; }
  .status { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 6px; white-space: nowrap; }
  .status--sent { background: var(--reliable-dim); color: var(--reliable); }
  .status--drop { background: var(--danger-dim); color: var(--danger); }
  .status--cold { background: var(--accent-dim); color: var(--accent); }
  .status--warm { background: var(--warn-dim); color: var(--warn); }

  /* ============ DIFF PANELS ============ */
  .diff-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
  .diff-panels > * { min-width: 0; overflow-wrap: break-word; }
  .diff-panel__header { font-family: var(--font-mono); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; padding: 10px 16px; }
  .diff-panel__header--before { background: var(--danger-dim); color: var(--danger); border-bottom: 2px solid var(--danger); }
  .diff-panel__header--after { background: var(--reliable-dim); color: var(--reliable); border-bottom: 2px solid var(--reliable); }
  .diff-panel__body { padding: 0; background: var(--surface); }
  .code-block { font-family: var(--font-mono); font-size: 12.5px; line-height: 1.55; padding: 16px; white-space: pre-wrap; word-break: break-word; overflow-x: auto; margin: 0; color: var(--text); }
  .code-block .c { color: var(--text-dim); }       /* comment */
  .code-block .del { color: var(--danger); }
  .code-block .add { color: var(--reliable); }
  @media (max-width: 768px) { .diff-panels { grid-template-columns: 1fr; } }

  .code-file { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin: 14px 0; }
  .code-file__header { padding: 9px 16px; background: var(--surface2); border-bottom: 1px solid var(--border); font-family: var(--font-mono); font-size: 11.5px; color: var(--text-dim); }
  .code-file__body { padding: 16px; background: var(--surface); white-space: pre-wrap; word-break: break-word; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.55; color: var(--text); }

  .footer-note { margin-top: 56px; padding-top: 20px; border-top: 1px solid var(--border); font-family: var(--font-mono); font-size: 11px; color: var(--text-dim); }

  @media (max-width: 768px) {
    .container { padding: 28px 18px 0; }
    .topnav__inner { padding: 8px 18px; }
    .mermaid-wrap { padding: 16px 10px; min-height: 360px; }
  }
</style>
</head>
<body>

<nav class="topnav">
  <div class="topnav__inner">
    <span class="topnav__brand">CircuitBreaker · STG Investigation</span>
    <a href="#summary">Summary</a>
    <a href="#channels">Two Channels</a>
    <a href="#bug">The Bug</a>
    <a href="#evidence">Evidence</a>
    <a href="#pr91">PR&nbsp;#91</a>
    <a href="#fix">The Fix</a>
    <a href="#reco">Next Steps</a>
  </div>
</nav>

<div class="container">

  <header class="page animate" style="--i:0">
    <div class="eyebrow">Infrastructure Investigation</div>
    <h1>Circuit Breaker → Slack: Why Some Alerts Are Missed (and the Fix)</h1>
    <div class="meta-line">
      <span>Environment: verup STG (account 520411743393)</span>
      <span>Log group: /aws/containerinsights/point/application</span>
      <span>Method: AWS CLI, read-only</span>
    </div>
  </header>

  <!-- ============ SUMMARY ============ -->
  <section class="block" id="summary">
    <div class="ve-card ve-card--hero animate" style="--i:1">
      <div class="section-label" style="color:var(--accent)">Executive summary</div>
      <p class="lead" style="margin-bottom:10px">
        Both point and verup send the custom circuit-breaker alert through the same
        <strong>Lambda webhook (Channel ①)</strong> &mdash; running the <strong>identical, racy throttle code</strong>.
        It drops events on cold starts on <em>both</em> sides (point STG: ~13% over 7 days). Point only
        <em>looks</em> reliable because its trips arrive in denser bursts that keep the container warm; verup's
        trips are sparse, so far more land on a cold container and are dropped.
      </p>
      <p class="muted" style="margin-bottom:0">
        So the real difference is <strong>event density (warm vs cold containers)</strong> &mdash; not the code,
        not the channel. A separate metric → alarm → Chatbot path (Channel ②) is an independent safety net that
        fires on every trip. The fix removes the cold-start blind spot in the Lambda so the first alert after a
        quiet period is no longer swallowed, while preserving the 10-minute anti-spam window.
      </p>
    </div>

    <div class="kpi-row">
      <div class="kpi-card" style="--i:0"><div class="kpi-card__value">15</div><div class="kpi-card__label">Lambda invocations / 12h<br>(every matching log was delivered)</div></div>
      <div class="kpi-card" style="--i:1"><div class="kpi-card__value ok">0</div><div class="kpi-card__label">Lambda errors<br>(not a crash / not the filter)</div></div>
      <div class="kpi-card" style="--i:2"><div class="kpi-card__value bad">~10&nbsp;min&nbsp;−&nbsp;ε</div><div class="kpi-card__label">cold-start time_diff vs the strict &gt;10&nbsp;min gate</div></div>
      <div class="kpi-card" style="--i:3"><div class="kpi-card__value bad">~13%</div><div class="kpi-card__label">point STG also drops events (18 / 136, 7d) — same Lambda, same bug</div></div>
    </div>
  </section>

  <!-- ============ TWO CHANNELS ============ -->
  <section class="block" id="channels">
    <div class="section-label">01 · System — two delivery channels</div>
    <h2>One log, two paths to Slack</h2>
    <p class="muted">
      Every worker log matching <code>Circuit Breaker symbol:*</code> fans out to two independent pipelines.
      Both are deployed on point and on verup STG.
    </p>

    <section class="diagram-shell animate" style="--i:2">
      <p class="diagram-shell__hint">Ctrl/Cmd + wheel to zoom · drag to pan · double-click to fit · ⛶ opens full size</p>
      <div class="mermaid-wrap">
        <div class="zoom-controls">
          <button type="button" data-action="zoom-in" title="Zoom in">+</button>
          <button type="button" data-action="zoom-out" title="Zoom out">&minus;</button>
          <button type="button" data-action="zoom-fit" title="Smart fit">&#8634;</button>
          <button type="button" data-action="zoom-one" title="1:1 zoom">1:1</button>
          <button type="button" data-action="zoom-expand" title="Open full size">&#x26F6;</button>
          <span class="zoom-label">Loading…</span>
        </div>
        <div class="mermaid-viewport"><div class="mermaid mermaid-canvas"></div></div>
      </div>
      <script type="text/plain" class="diagram-source">
        graph TD
          LOG["Worker log<br/>Circuit Breaker symbol:*"]

          LOG -->|subscription filter| LAM["Lambda: circuitbreaker-to-slack<br/>in-memory 10-min throttle"]
          LAM -->|incoming webhook| WH["Slack message<br/>(PointOPECircuitBreaker)"]

          LOG -->|metric filter| MF["Metric: circuitBreaker-DETECTED<br/>namespace point-metrics"]
          MF --> AL["CloudWatch alarm<br/>circuitBreaker-DETECTED"]
          AL -->|alarm action| SNS["SNS topic<br/>alert-chatbot-worker"]
          SNS --> CB["AWS Chatbot"]
          CB --> SL["Slack channel"]

          class LAM,WH chan1
          class MF,AL,SNS,CB,SL chan2

          classDef chan1 fill:#fde7e7,stroke:#b91c1c,stroke-width:2px,color:#7f1d1d,stroke-dasharray:5 4
          classDef chan2 fill:#ccf3ee,stroke:#0f766e,stroke-width:2px,color:#134e4a
      </script>
    </section>

    <div class="legend">
      <div class="legend-item"><span class="legend-swatch" style="background:#b91c1c"></span> Channel ① — Lambda webhook (racy, drops first alert)</div>
      <div class="legend-item"><span class="legend-swatch" style="background:#0f766e"></span> Channel ② — Metric → Alarm → Chatbot (reliable)</div>
    </div>

    <div class="callout callout--info animate" style="--i:3">
      <div class="callout__title">Which channel is "point sends normally"?</div>
      <p>
        Point relies on <strong>Channel ①</strong> (the custom "PointOPECircuitBreaker" message) as its primary
        circuit-breaker alert &mdash; the same as verup. Point's Channel ① is <strong>not bug-free</strong>: it
        drops ~13% of events (see §04). It looks normal because point's trips arrive in denser bursts that keep
        the Lambda container warm. Channel ② (the AWS Chatbot alarm notification) is a separate, independent
        message that also fires &mdash; a safety net, not the reason Channel ① "works" on point.
      </p>
    </div>
  </section>

  <!-- ============ THE BUG ============ -->
  <section class="block" id="bug">
    <div class="section-label">02 · Root cause — the cold-start throttle</div>
    <h2>Why Channel ① silently drops the first alert</h2>
    <p>
      The Lambda keeps throttle state in a module-global <code>last_log_sent_time</code>, initialized at
      <strong>cold start</strong> to <code>datetime.now() - 10min</code>, and only alerts when
      <code>time_diff &gt; 10 minutes</code> (strict greater-than).
    </p>

    <div class="callout callout--bug">
      <div class="callout__title">The mechanism</div>
      <p>
        On a cold start, the triggering log's <code>@timestamp</code> precedes the container init time by the
        delivery latency (measured ≈ 1–2&nbsp;s; ingestion time ≈ <code>@timestamp</code>). So:
      </p>
      <p style="font-family:var(--font-mono); font-size:13px; background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:12px 14px; color:var(--text)">
        time_diff = event_time − (now − 10min) = <strong>10min − delivery_latency ≈ 9min 59s</strong><br>
        9min 59s &gt; 10min  →  <strong style="color:var(--danger)">False → alert swallowed</strong>
      </p>
      <p>
        Because circuit-breaker events are <strong>sparse</strong> (clusters hours apart), the container is
        <strong>always cold</strong> for the first event of a cluster &mdash; so the important first alert after
        a quiet period is reliably dropped.
      </p>
    </div>

    <h3>Why follow-up events are a coin flip</h3>
    <p class="muted">
      A second event ~1 minute later is sent <em>only</em> if AWS reuses the warm container (it inherits the
      old baseline, so the gap clears 10&nbsp;min). If AWS spins a fresh cold container instead, the baseline
      resets to <code>now − 10min</code> and the event is dropped again. Whether a warm container is reused is
      nondeterministic &mdash; that is the raciness.
    </p>
  </section>

  <!-- ============ EVIDENCE ============ -->
  <section class="block" id="evidence">
    <div class="section-label">03 · Evidence — the 16:09 vs 16:51 case (ICT)</div>
    <h2>Same event type, 42 minutes apart — one sent, one dropped</h2>
    <p class="muted">
      Each matching log was delivered and the Lambda ran without error. The only variable was cold vs warm
      container. Times in ICT (UTC+7); UTC in parentheses.
    </p>

    <div class="table-wrap animate" style="--i:2">
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Event (ICT / UTC)</th>
              <th>Gap before</th>
              <th>Container</th>
              <th>time_diff vs gate</th>
              <th>Channel ① Lambda</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="num">16:08:16 <small>09:08 UTC</small></td>
              <td>cluster start</td>
              <td><span class="status status--cold">cold</span></td>
              <td class="num">≈ 9m59s</td>
              <td><span class="status status--drop">swallowed</span></td>
            </tr>
            <tr>
              <td class="num">16:09:16 <small>09:09 UTC</small></td>
              <td class="num">+1 min</td>
              <td><span class="status status--warm">warm reuse</span></td>
              <td class="num">10m59s</td>
              <td><span class="status status--sent">SENT</span></td>
            </tr>
            <tr>
              <td class="num">16:50:16 <small>09:50 UTC</small></td>
              <td class="num">+41 min</td>
              <td><span class="status status--cold">cold</span></td>
              <td class="num">≈ 9m59s</td>
              <td><span class="status status--drop">swallowed</span></td>
            </tr>
            <tr>
              <td class="num">16:51:16 <small>09:51 UTC</small></td>
              <td class="num">+1 min</td>
              <td><span class="status status--cold">cold again</span></td>
              <td class="num">≈ 9m59s</td>
              <td><span class="status status--drop">swallowed</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="muted" style="font-size:13px; margin-top:10px">
      At 16:09 the +1-min follow-up reused the warm container (no <code>INIT_START</code> in the Lambda log) and
      inherited the old baseline → sent. At 16:51 AWS cold-started a new container for the follow-up too
      (<code>INIT_START</code> present) → baseline reset → swallowed. Lambda durations confirm it: swallowed
      runs finish in ~35&nbsp;ms (no network call); sent runs take ~800&nbsp;ms.
    </p>

    <div class="callout callout--ok">
      <div class="callout__title">Channel ② fired at BOTH times</div>
      <p>
        Alarm <code>circuitBreaker-DETECTED</code> history: <strong>OK→ALARM at 16:09:55 and again at
        16:51:55</strong> (also 15:48 and 13:40). The SNS topic <code>alert-chatbot-worker</code> has an AWS
        Chatbot subscription. So the reliable channel delivered at 16:51 even though the Lambda did not.
      </p>
    </div>

    <div class="callout callout--info" style="margin-top:14px">
      <div class="callout__title">Ruled out</div>
      <p style="margin-bottom:0">
        Subscription filter is attached with the correct pattern · Lambda invoked for every matching log ·
        Errors = 0 · not in a VPC (egress to Slack works) · gzip guard produced 0 early returns · ingestion
        time ≈ <code>@timestamp</code> (so the timestamp is genuine UTC, not a timezone bug).
      </p>
    </div>
  </section>

  <!-- ============ PR 91 ============ -->
  <section class="block" id="pr91">
    <div class="section-label">04 · Finding — point runs the same buggy Lambda</div>
    <h2>Point's Lambda is identical — and drops ~13% too</h2>
    <p>
      The point-side PR (branch <code>feature/pouh529</code>) diff produces a <strong>byte-for-byte identical
      Lambda</strong> to verup's current code. It only <strong>adds SES email</strong> and refactors the Slack
      call into helper functions &mdash; it does <strong>not touch the throttle</strong> (the
      <code>datetime.now() - 10min</code> init and the strict <code>&gt; 10min</code> gate are unchanged).
    </p>
    <p>
      Confirmed at runtime on <strong>point STG (account 471112755246)</strong>: over 7 days the Lambda ran
      <strong>136 times</strong>, posted to Slack <strong>118</strong> times, and <strong>swallowed 18
      (~13%)</strong> &mdash; with no reserved or provisioned concurrency. Same code, same cold-start drops.
    </p>
    <div class="callout callout--warn">
      <div class="callout__title">Implication — corrected</div>
      <p style="margin-bottom:0">
        Point is <em>not</em> reliable because of a better Lambda, and not merely because of Channel ②. Point's
        Channel ① has the same bug; it just drops a smaller fraction because point's trips arrive in denser
        bursts (warm containers). verup's trips are sparser, so a larger fraction hit cold containers and are
        dropped &mdash; which is why the gap is visible on verup. "Copying point" fixes nothing; the patch
        below must be applied to PR #91 before it merges.
      </p>
    </div>
  </section>

  <!-- ============ THE FIX ============ -->
  <section class="block" id="fix">
    <div class="section-label">05 · The fix</div>
    <h2>Make the first alert after a cold start always send</h2>
    <p class="muted">
      Use a <code>None</code> sentinel instead of an artificial <code>now − 10min</code> baseline. The first log
      seen by a cold container always alerts; the 10-minute anti-spam window is preserved for follow-ups on a
      warm container.
    </p>

    <div class="diff-panels animate" style="--i:2">
      <div class="diff-panel__header diff-panel__header--before">Before — silently drops first alert</div>
      <div class="diff-panel__header diff-panel__header--after">After — first alert always sends</div>
      <div class="diff-panel__body">
<pre class="code-block"><span class="c"># init at cold start</span>
last_log_sent_time = <span class="del">datetime.now() \
    - timedelta(minutes=10)</span>
...
time_diff = strptime(ts) \
    - last_log_sent_time
<span class="c"># strict &gt; 10 min</span>
if <span class="del">time_diff &gt; timedelta(minutes=10)</span>:
    ... send ...
    if slack_sent or mail_sent:
        last_log_sent_time = <span class="del">strptime(ts)</span></pre>
      </div>
      <div class="diff-panel__body">
<pre class="code-block"><span class="c"># sentinel: nothing sent yet</span>
last_log_sent_time = <span class="add">None</span>
...
event_time = strptime(ts)

<span class="c"># first-ever OR &gt; 10 min apart</span>
if <span class="add">last_log_sent_time is None or \
   (event_time - last_log_sent_time)
       &gt; timedelta(minutes=10)</span>:
    ... send ...
    if slack_sent or mail_sent:
        last_log_sent_time = <span class="add">event_time</span></pre>
      </div>
    </div>

    <h3>Trade-off</h3>
    <p class="muted">
      Throttle state is still per-container and in-memory, now biased toward sending. During a burst, several
      concurrent cold containers could each emit one duplicate &mdash; acceptable for a safety alert
      (over-alert beats a silent miss). An exact global throttle would require externalizing state (e.g.
      DynamoDB), but that is unnecessary because Channel ② already provides robust coverage.
    </p>

    <div class="callout callout--warn">
      <div class="callout__title">Deploy note</div>
      <p style="margin-bottom:0">
        Terraform deploys <code>lambda_function.zip</code>, not <code>src/</code>. The zip must be rebuilt from
        the edited source before <code>plan</code> / <code>apply</code>, otherwise the change is not picked up.
      </p>
    </div>
  </section>

  <!-- ============ RECOMMENDATIONS ============ -->
  <section class="block" id="reco">
    <div class="section-label">06 · Recommendations</div>
    <h2>Next steps</h2>
    <ol class="clean">
      <li><strong>Apply the same patch to point PR #91</strong> before it merges &mdash; it carries the identical bug.</li>
      <li><strong>Rebuild the Lambda zip</strong> and run <code>plan</code> on STG to confirm only the function code changes.</li>
      <li><strong>Channel ① is a primary alert path on both point and verup</strong> — not redundant. Channel ② (alarm → Chatbot) is a useful independent safety net, but the custom Lambda message is what teams actually watch, so fixing the throttle matters on both sides.</li>
      <li><strong>If exact global de-duplication is ever required</strong>, externalize throttle state (DynamoDB conditional write + TTL) rather than relying on per-container memory.</li>
    </ol>
  </section>

  <div class="footer-note">
    Sources: live AWS CLI read-only queries on verup STG (account 520411743393) and point STG (account
    471112755246) — subscription filters, Lambda config / runtime logs / invocation metrics, alarm history, SNS
    subscriptions · component source in bs-exchange-infra · point-side PR diff. Slack webhook URLs and SES
    recipient addresses intentionally omitted.
  </div>

</div>

<script type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  const config = { fitPadding: 28, minHeight: 360, maxHeightPx: 960, maxHeightVh: 0.84, maxInitialZoom: 1.8, minZoom: 0.08, maxZoom: 6.5, zoomStep: 0.14, readabilityFloor: 0.58 };
  const clamp = (n, lo, hi) => Math.max(lo, Math.min(hi, n));
  let activeDrag = null;
  addEventListener('mousemove', (e) => activeDrag?.onMove(e));
  addEventListener('mouseup', () => { activeDrag?.onEnd(); activeDrag = null; });

  const isDark = matchMedia('(prefers-color-scheme: dark)').matches;

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    look: 'classic',
    themeVariables: {
      fontFamily: "'IBM Plex Sans', system-ui, sans-serif",
      fontSize: '15px',
      primaryColor: isDark ? '#15223b' : '#ffffff',
      primaryBorderColor: isDark ? '#6aa3f0' : '#1e477e',
      primaryTextColor: isDark ? '#dde7f6' : '#14233b',
      lineColor: isDark ? '#8aa0c0' : '#5a6b86',
      tertiaryColor: isDark ? '#0e182b' : '#f4f7fb',
    }
  });

  function initDiagram(shell) {
    const wrap = shell.querySelector('.mermaid-wrap');
    const viewport = shell.querySelector('.mermaid-viewport');
    const canvas = shell.querySelector('.mermaid-canvas');
    const source = shell.querySelector('.diagram-source');
    const label = shell.querySelector('.zoom-label');
    if (!wrap || !viewport || !canvas || !source || !label) return;

    let zoom = 1, fitMode = 'contain', panX = 0, panY = 0, svgW = 0, svgH = 0;
    let sx = 0, sy = 0, spx = 0, spy = 0, touchDist = 0, touchCx = 0, touchCy = 0;

    function constrainPan() {
      const vpW = viewport.clientWidth, vpH = viewport.clientHeight;
      const rW = svgW * zoom, rH = svgH * zoom, pad = config.fitPadding;
      panX = (rW + pad * 2 <= vpW) ? (vpW - rW) / 2 : clamp(panX, vpW - rW - pad, pad);
      panY = (rH + pad * 2 <= vpH) ? (vpH - rH) / 2 : clamp(panY, vpH - rH - pad, pad);
    }
    function applyTransform() {
      const svg = canvas.querySelector('svg'); if (!svg || !svgW) return;
      constrainPan();
      svg.style.width = (svgW * zoom) + 'px'; svg.style.height = (svgH * zoom) + 'px';
      canvas.style.transform = `translate(${panX}px, ${panY}px)`;
      label.textContent = Math.round(zoom * 100) + '% — ' + fitMode;
    }
    function canPan() {
      const rW = svgW * zoom, rH = svgH * zoom;
      return rW + config.fitPadding * 2 > viewport.clientWidth || rH + config.fitPadding * 2 > viewport.clientHeight;
    }
    function computeSmartFit() {
      const vpW = viewport.clientWidth, vpH = viewport.clientHeight;
      const aW = Math.max(80, vpW - config.fitPadding * 2), aH = Math.max(80, vpH - config.fitPadding * 2);
      const contain = Math.min(aW / svgW, aH / svgH);
      let z = contain, mode = 'contain';
      if (contain < config.readabilityFloor) {
        const chartR = svgH / svgW, vpR = vpH / Math.max(vpW, 1);
        if (chartR >= vpR) { z = aW / svgW; mode = 'width-priority'; } else { z = aH / svgH; mode = 'height-priority'; }
      }
      return { zoom: clamp(z, config.minZoom, config.maxInitialZoom), mode };
    }
    function fitDiagram() {
      if (!svgW) return;
      const fit = computeSmartFit(); zoom = fit.zoom; fitMode = fit.mode;
      panX = (viewport.clientWidth - svgW * zoom) / 2; panY = (viewport.clientHeight - svgH * zoom) / 2;
      applyTransform();
    }
    function setOneToOne() {
      zoom = clamp(1, config.minZoom, config.maxZoom); fitMode = '1:1';
      panX = (viewport.clientWidth - svgW * zoom) / 2; panY = (viewport.clientHeight - svgH * zoom) / 2;
      applyTransform();
    }
    function zoomAround(factor, cx, cy) {
      const next = clamp(zoom * factor, config.minZoom, config.maxZoom), ratio = next / zoom;
      panX = cx - ratio * (cx - panX); panY = cy - ratio * (cy - panY); zoom = next; fitMode = 'custom'; applyTransform();
    }
    function readSvgNaturalSize(svg) {
      let w = 0, h = 0;
      if (svg.viewBox?.baseVal?.width > 0) { w = svg.viewBox.baseVal.width; h = svg.viewBox.baseVal.height; }
      if (!w) { w = parseFloat(svg.getAttribute('width')) || 0; h = parseFloat(svg.getAttribute('height')) || 0; }
      if (!w) { const b = svg.getBBox(); w = b.width; h = b.height; }
      if (!w) { const r = svg.getBoundingClientRect(); w = r.width || 1000; h = r.height || 700; }
      if (!svg.getAttribute('viewBox')) svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      return { w, h };
    }
    function setAdaptiveHeight() {
      if (!svgW) return;
      const usableW = Math.max(280, wrap.getBoundingClientRect().width - 2);
      const idealH = (svgH / svgW) * usableW + config.fitPadding * 2;
      const maxVp = Math.floor(innerHeight * config.maxHeightVh);
      const hardMax = Math.min(config.maxHeightPx, Math.max(config.minHeight + 40, maxVp));
      wrap.style.height = Math.round(clamp(idealH, config.minHeight, hardMax)) + 'px';
    }
    function openInNewTab() {
      const svg = canvas.querySelector('svg'); if (!svg) return;
      const clone = svg.cloneNode(true); clone.style.width = ''; clone.style.height = '';
      const bg = isDark ? '#0a1120' : '#eef2f8';
      const html = `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Diagram</title><style>body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:${bg};padding:40px;box-sizing:border-box}svg{max-width:100%;max-height:90vh;height:auto}</style></head><body>${clone.outerHTML}</body></html>`;
      open(URL.createObjectURL(new Blob([html], { type: 'text/html' })), '_blank');
    }
    async function render() {
      try {
        const code = source.textContent.trim();
        if (!code) { label.textContent = 'Error: Empty source'; return; }
        const id = 'diagram-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
        const { svg } = await mermaid.render(id, code);
        canvas.innerHTML = svg;
        const svgNode = canvas.querySelector('svg'); if (!svgNode) { label.textContent = 'Error: No SVG'; return; }
        const size = readSvgNaturalSize(svgNode); svgW = size.w; svgH = size.h;
        svgNode.removeAttribute('width'); svgNode.removeAttribute('height');
        svgNode.style.maxWidth = 'none'; svgNode.style.display = 'block';
        setAdaptiveHeight(); fitDiagram();
      } catch (err) { console.error('Mermaid render failed:', err); label.textContent = 'Error: ' + (err.message || 'Render failed'); }
    }
    const actions = {
      'zoom-in': () => zoomAround(1 + config.zoomStep, viewport.clientWidth / 2, viewport.clientHeight / 2),
      'zoom-out': () => zoomAround(1 / (1 + config.zoomStep), viewport.clientWidth / 2, viewport.clientHeight / 2),
      'zoom-fit': fitDiagram, 'zoom-one': setOneToOne, 'zoom-expand': openInNewTab
    };
    Object.entries(actions).forEach(([action, handler]) => { wrap.querySelector(`[data-action="${action}"]`)?.addEventListener('click', handler); });
    viewport.addEventListener('dblclick', fitDiagram);
    viewport.addEventListener('wheel', (e) => {
      if (e.ctrlKey || e.metaKey) { e.preventDefault(); const rect = viewport.getBoundingClientRect(); const factor = e.deltaY < 0 ? 1 + config.zoomStep : 1 / (1 + config.zoomStep); zoomAround(factor, e.clientX - rect.left, e.clientY - rect.top); return; }
      if (canPan()) { e.preventDefault(); panX -= e.deltaX; panY -= e.deltaY; applyTransform(); }
    }, { passive: false });
    viewport.addEventListener('mousedown', (e) => {
      if (e.target.closest('.zoom-controls') || !canPan()) return;
      wrap.classList.add('is-panning'); sx = e.clientX; sy = e.clientY; spx = panX; spy = panY; e.preventDefault();
      activeDrag = { onMove: (ev) => { panX = spx + (ev.clientX - sx); panY = spy + (ev.clientY - sy); applyTransform(); }, onEnd: () => { wrap.classList.remove('is-panning'); } };
    });
    viewport.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; spx = panX; spy = panY; }
      else if (e.touches.length === 2) { const dx = e.touches[0].clientX - e.touches[1].clientX, dy = e.touches[0].clientY - e.touches[1].clientY; touchDist = Math.sqrt(dx*dx+dy*dy); const r = viewport.getBoundingClientRect(); touchCx = (e.touches[0].clientX + e.touches[1].clientX)/2 - r.left; touchCy = (e.touches[0].clientY + e.touches[1].clientY)/2 - r.top; }
    }, { passive: true });
    viewport.addEventListener('touchmove', (e) => {
      if (e.touches.length === 1 && canPan()) { if (touchDist > 0) { sx = e.touches[0].clientX; sy = e.touches[0].clientY; spx = panX; spy = panY; touchDist = 0; } e.preventDefault(); panX = spx + (e.touches[0].clientX - sx); panY = spy + (e.touches[0].clientY - sy); applyTransform(); }
      else if (e.touches.length === 2 && touchDist > 0) { e.preventDefault(); const dx = e.touches[0].clientX - e.touches[1].clientX, dy = e.touches[0].clientY - e.touches[1].clientY; const d = Math.sqrt(dx*dx+dy*dy); zoomAround(d / touchDist, touchCx, touchCy); touchDist = d; }
    }, { passive: false });
    new ResizeObserver(() => { if (svgW) { setAdaptiveHeight(); fitDiagram(); } }).observe(wrap);
    render();
  }
  document.querySelectorAll('.diagram-shell').forEach(initDiagram);
</script>

</body>
</html>
